[sub_resource type="GDScript" id="GDScript_prev2"]
script/source = "extends Node2D
## Throwaway harness. Delete when done.

func _ready() -> void:
	var vfx: VfxManager = $VfxManager
	vfx.setup(null, null, $Vfx)
	loop(vfx)

func loop(vfx: VfxManager) -> void:
	while is_inside_tree():
		# Death marker (skull sheet) — left.
		vfx.flipbook_at_position(Vector2(260, 400), VfxManager.DEATH_SHEET,
			VfxManager.DEATH_HFRAMES * VfxManager.DEATH_VFRAMES, 1.9, 72.0,
			VfxManager.DEATH_VFRAMES)
		# Keg blast, exactly as _on_hazard_detonated fires it — centre.
		vfx.flipbook_at_position(Vector2(700, 400), VfxManager.EXPLOSION_SHEET,
			VfxManager.EXPLOSION_FRAMES, 0.45, 110.0)
		vfx.burst_at_position(Vector2(700, 400), \"fireball\")
		vfx.burst_at_position(Vector2(700, 400), \"flame\")
		vfx.burst_at_position(Vector2(700, 400), \"ember\")
		# Ordinary hit dust — right, to confirm it is no longer a wide smear.
		vfx.burst_at_position(Vector2(1150, 400), \"impact\")
		await get_tree().create_timer(0.45).timeout
"

